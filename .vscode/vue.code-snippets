{
  "Vue 3 Script Setup Standard": {
    "prefix": "vbase3-setup",
    "body": [
      "<script setup lang=\"ts\">",
      "import { ref, reactive, computed, watch, onMounted } from 'vue'",
      "",
      "// ==========================================",
      "// 1. 组件配置 & 宏声明 (Options & Macros)",
      "// ==========================================",
      "defineOptions({",
      "  name: '${1:ComponentName}'",
      "})",
      "",
      "const props = defineProps<{}>()",
      "const emit = defineEmits<{}>()",
      "",
      "// ==========================================",
      "// 2. 依赖注入与模板引用 (Provide/Inject & Template Refs)",
      "// ==========================================",
      "$2",
      "",
      "// ==========================================",
      "// 3. 响应式数据 (State)",
      "// ==========================================",
      "$3",
      "",
      "// ==========================================",
      "// 4. 计算属性 (Computed)",
      "// ==========================================",
      "$4",
      "",
      "// ==========================================",
      "// 5. 侦听器 (Watchers)",
      "// ==========================================",
      "$5",
      "",
      "// ==========================================",
      "// 6. 业务方法 (Methods)",
      "// ==========================================",
      "$6",
      "",
      "// ==========================================",
      "// 7. 生命周期钩子 (Lifecycle)",
      "// ==========================================",
      "onMounted(() => {",
      "  $7",
      "})",
      "",
      "// ==========================================",
      "// 8. 暴露对外API (Expose)",
      "// ==========================================",
      "defineExpose({})",
      "</script>",
      "",
      "<template>",
      "  <div class=\"${1/(.*)/${1:/downcase}/}-container\">",
      "    $8",
      "  </div>",
      "</template>",
      "",
      "<style scoped lang=\"scss\">",
      ".${1/(.*)/${1:/downcase}/}-container {",
      "  $9",
      "}",
      "</style>"
    ],
    "description": "Generate a standardized Vue 3 script setup component"
  }
}